{
  "name": "jobflex",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && node --max-old-space-size=8192 node_modules/next/dist/bin/next dev",
    "dev:pg": "node scripts/dev-postgres.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:changed": "node scripts/lint-changed.mjs",
    "typecheck": "tsc --noEmit",
    "fleet": "node scripts/fleet.js --watch",
    "fleet:once": "node scripts/fleet.js",
    "fleet:list": "node scripts/fleet.js --list",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "qa": "tsx qa/bin/qa.ts",
    "qa:smoke": "tsx qa/bin/qa.ts --suite smoke",
    "qa:build-run": "tsx qa/bin/build-run.ts",
    "qa:analyze": "tsx qa/bin/analyze.ts",
    "qa:summary": "tsx qa/bin/summary.ts",
    "qa:alert": "tsx qa/bin/alert.ts",
    "qa:accept": "tsx qa/bin/accept.ts",
    "qa:selftest": "tsx qa/bin/selftest.ts",
    "qa:seed-roles": "tsx qa/bin/seed-roles.ts",
    "qa:seed": "tsx qa/bin/seed.ts",
    "qa:install": "npm --prefix qa install && npm --prefix qa exec -- playwright install chromium webkit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.0.2",
    "@hookform/resolvers": "^3.9.1",
    "@paypal/react-paypal-js": "^8.7.0",
    "@prisma/client": "5.22.0",
    "@prisma/extension-accelerate": "1.2.1",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "11.6.0",
    "@stripe/stripe-js": "^4.10.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "fast-png": "^6.4.0",
    "framer-motion": "11.18.2",
    "geotiff": "^2.1.3",
    "googleapis": "^144.0.0",
    "gsap": "^3.15.0",
    "imapflow": "2.2.4",
    "immer": "^10.1.1",
    "laz-perf": "^0.0.7",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.9",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "openai": "6.16.0",
    "pdfjs-dist": "^4.10.38",
    "postal-mime": "2.7.5",
    "posthog-js": "^1.422.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.0",
    "react-is": "^19.2.7",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "resend": "^6.4.0",
    "square": "^45.1.0",
    "stripe": "19.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.171.0",
    "twilio": "^5.3.0",
    "zod": "^3.23.8",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.0.10",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "^4.19.2",
    "typescript": "5.6.2"
  }
}
