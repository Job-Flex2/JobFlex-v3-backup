// ─────────────────────────────────────────────
// Billing / Admin
// ─────────────────────────────────────────────

model Subscription {
  id                     String    @id @default(cuid())
  organizationId         String    @unique
  plan                   String    @default("FREE")
  status                 String    @default("FREE")
  provider               String    @default("STRIPE")
  externalCustomerId     String?
  externalSubId          String?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  // Stripe-truth mirror fields, synced from subscription/invoice webhooks.
  stripePriceId          String?
  appliedPromotionCodeId String? // promo_... read off the subscription discount
  appliedCouponId        String? // coupon_... fallback
  attributionId          String? // → Attribution (influencer promo link)
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PricingPlan {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  priceCents       Int // monthly price
  yearlyPriceCents Int? // optional annual price (enables yearly checkout + savings display)
  interval         String   @default("month")
  trialDays        Int      @default(0)
  order            Int      @default(0)
  features         String
  limitsJson       String? // numeric per-plan limits (see src/lib/planLimits.ts); null/absent key = unlimited
  active           Boolean  @default(true) // hidden from user surfaces + rejected at checkout when false
  highlight        Boolean  @default(false) // "Most popular" badge on plan surfaces
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model SupportTicket {
  id             String    @id @default(cuid())
  organizationId String
  userId         String? // submitter, when raised from the in-app support form
  subject        String
  body           String
  category       String    @default("general") // billing | technical | account | feature | general — for admin triage
  priority       String    @default("normal") // low | normal | high — submitter-declared urgency
  status         String    @default("OPEN")
  adminReadAt    DateTime? // platform-admin "seen" marker; null = new/unread in the admin notification feed — cleared again by every customer message
  lastMessageAt  DateTime  @default(now()) // the conversation's latest message (the ticket itself, then SupportMessage) — the queue's order
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([lastMessageAt])
}

// ── Why a plan was cancelled (owner, 2026-10-20) ────────────────────────────
// One row per cancellation booked from Settings → Billing → Manage
// subscription → … → "Cancel <plan>?" (actions/billing cancelSubscription),
// where the owner must tick at least one reason. `reasons` is a JSON array of
// lib/cancelFeedback keys; `otherText` is the "Other" box (3–500 chars) and
// null otherwise. `plan` and `periodEnd` are as they stood when it was booked.
// Read by /admin/cancellations and the /admin/users sheet.
model CancellationFeedback {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  plan           String
  reasons        String    @default("[]")
  otherText      String?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// ── More trial days, asked from "Before you go" (owner, 2026-10-20) ─────────
// Offered only while the plan is on its trial or the trial ended at most 14
// days ago (lib/trialExtension). One PENDING row per organization at a time.
// status: PENDING | APPROVED | DENIED. A platform admin decides in
// /admin/trial-requests: Approve moves the Stripe trial_end (or, for a plan
// with no Stripe subscription, only the local date — `localOnly`), Deny keeps
// a short reason. `plan`, `trialStartedAt` and `trialEndsAt` are as they stood
// when it was asked; `extendedUntil` is the trial end Approve set.
model TrialExtensionRequest {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  requestedDays  Int
  note           String?
  status         String    @default("PENDING")
  plan           String?
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  grantedDays    Int?
  extendedUntil  DateTime?
  localOnly      Boolean   @default(false)
  decisionNote   String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("TrialExtensionRequester", fields: [userId], references: [id], onDelete: SetNull)
  decider      User?        @relation("TrialExtensionDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status, createdAt])
}

// ── Why plan charges fail (owner, 2026-10-21) ───────────────────────────────
// One row per declined try of a JobFlex plan invoice, written by the Stripe
// webhook (invoice.payment_failed) and by scripts/backfill-payment-failures.ts
// through the same code (lib/paymentFailures). The reason is the attempt's own
// (the payment intent's last_payment_error, else the failed charge); the card
// is the one charged. `ignored`: Stripe sent the failure, but nothing was owed
// — a declined plan change, or an old failure after the invoice was paid (the
// subscription is active or trialing). `isTrialEnd`: the first charge after a
// trial. `recoveredAt`: the invoice was paid in the end (invoice.paid). The
// organization is kept loose (SetNull) so a deleted company's failures still
// count. cardFunding: credit | debit | prepaid | unknown.
model PaymentFailure {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  organizationId       String?
  subscriptionId       String?
  stripeInvoiceId      String
  stripeSubscriptionId String?
  attempt              Int
  amountCents          Int
  currency             String    @default("usd")
  billingReason        String?
  declineCode          String?
  errorCode            String?
  errorMessage         String?
  cardBrand            String?
  cardFunding          String    @default("unknown")
  cardLast4            String?
  isTrialEnd           Boolean   @default(false)
  ignored              Boolean   @default(false)
  recoveredAt          DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([stripeInvoiceId, attempt])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

// ── The conversation under a support ticket (owner, 2026-10-17) ─────────────
// One dialog per ticket that either side can write to from anywhere: the
// customer in the app (/dashboard/support) or by email, the team in
// /admin/support or by email, the support AI (lib/support). The ticket's own
// `body` is the opening message and is not copied here. Replaced the SyncState
// `supportReplies:<ticketId>` JSON lists (capped at 50, team side only);
// prisma/sql/prod-2026-10-17-support-messages.sql moves those over.
// Vocabularies are free Strings checked in lib/supportReply.
model SupportMessage {
  id             String   @id @default(cuid())
  ticketId       String
  from           String // customer | team | ai
  authorUserId   String? // who wrote it, when a signed-in person did
  authorName     String? // as signed: the admin's name, "JobFlex support"; null for the customer
  body           String
  channel        String   @default("app") // app | email — where it was written
  kind           String? // the AI's sends: answer | ack | fixed
  sentTo         String? // where the email to the other side went (team/ai → the customer's address)
  emailMessageId String? // inbound: the letter's Message-ID (dedupe); outbound: the provider's id
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([emailMessageId])
}

// ── Admin task tracker (/admin/tasks, 2026-10-11) ───────────────────────────
// The platform admins' own to-do list. Only platform admins read or write it
// (requirePlatformAdmin in every action and in /api/admin/tasks/changes).
// Vocabularies are free Strings validated in lib/adminTasks/model.ts, like
// SupportTicket.status. A task is never deleted: Canceled sends it to Archive.
// Every write to a subtask or comment touches the task's updatedAt, which is
// what the live "changed since" poll reads.
model AdminTask {
  id              String    @id @default(cuid())
  title           String
  description     String    @default("")
  priority        String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status          String    @default("TODO") // TODO | IN_PROGRESS | BLOCKED | DONE | CANCELED
  category        String    @default("OTHER") // BUG | FEATURE | SUPPORT | BILLING | MARKETING | OTHER
  assigneeId      String?
  authorId        String?
  dueDate         String? // "2026-10-14" — a calendar day, no clock and no zone
  linkUrl         String? // the related object: an app path ("/admin/support?ticket=…") or a URL
  // The ticket a "Create task" on /admin/support made this from. A plain
  // column, not a relation, so SupportTicket itself is untouched.
  supportTicketId String?   @unique
  closedAt        DateTime? // set on Done / Canceled, cleared on reopen
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignee User?              @relation("AdminTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  author   User?              @relation("AdminTaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  subtasks AdminTaskSubtask[]
  comments AdminTaskComment[]
  events   AdminTaskEvent[]

  @@index([updatedAt])
  @@index([status])
  @@index([assigneeId, status])
}

model AdminTaskSubtask {
  id         String   @id @default(cuid())
  taskId     String
  title      String
  done       Boolean  @default(false)
  assigneeId String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User?     @relation("AdminSubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId, position])
}

model AdminTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  task   AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User?     @relation("AdminTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

// The journal: who changed what, when. `from` / `to` are the values as they
// read at the time ("High", "Dana", "Oct 14"), so a later rename of a person
// or a subtask never rewrites history.
model AdminTaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  kind      String // CREATED | TITLE | STATUS | PRIORITY | ASSIGNEE | DUE | CATEGORY | DESCRIPTION | LINK | SUBTASK_ADDED | SUBTASK_DONE | SUBTASK_REOPENED | SUBTASK_RENAMED | SUBTASK_REMOVED | SUBTASK_ASSIGNED
  from      String?
  to        String?
  createdAt DateTime @default(now())

  task  AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User?     @relation("AdminTaskEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Specialty {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  promptPreamble String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

// ─────────────────────────────────────────────
// Stage 2E — New domains
// ─────────────────────────────────────────────

model ChangeOrder {
  id             String    @id @default(cuid())
  organizationId String
  // A change order amends a contract. It attaches to either a Job (legacy) or a
  // Proposal (the contract itself) — exactly one is set, enforced in the action.
  jobId          String?
  proposalId     String?
  title          String
  description    String?
  amount         Float // signed pre-tax delta: positive adds, negative reduces (legacy readers)
  status         String    @default("DRAFT") // DRAFT | SENT | APPROVED | DECLINED | VOID
  publicToken    String    @unique @default(cuid())
  sentAt         DateTime?
  approvedAt     DateTime?
  declinedAt     DateTime?
  approvedIp     String?
  // ── Itemized change orders (2026-09-13). All nullable: a row from before
  // this carries only `amount`, and an APPROVED row with `total` null was
  // already folded into its proposal's total by the old approval code, so the
  // contract-total derivation (lib/contractTotal) excludes it. ──
  number         Int? // per proposal: "CO #2"
  kind           String? // change-order type key: plywood_sheathing | custom | an org-authored key
  linesJson      String? // [{ key, name, quantity, unit, unitPrice, kind: material|labor, meta }]
  taxable        Boolean   @default(true)
  taxRate        Float? // copied from the proposal at send — a later rate edit cannot move a sent order
  taxTotal       Float?
  total          Float? // amount + taxTotal, rounded to cents; the installment an approval creates
  photosJson     String?   @default("[]") // [{ id, url, caption }] on Blob
  reason         String? // why the client is paying more — shown on the client page
  approvedName   String? // the client's typed full name (lightweight e-sign)
  approvedVia    String? // client | in_person
  approvedByUserId String? // the staff member who recorded an in-person approval
  approvedUserAgent String?
  declineReason  String?
  createdByUserId String?
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([proposalId, status])
  @@index([organizationId, status])
}

/// An org-authored change-order type — a form definition the generic sheet
/// renders (items with suggested prices, quantity helpers, photo/reason
/// flags). Built-in types (plywood / sheathing, custom) live in code
/// (src/lib/changeOrders/types.ts); rows here add more without a release.
model ChangeOrderType {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  label          String
  definitionJson String
  position       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}

/// The contractor's own price for a change-order item, per company: the
/// suggested price is a default; an override here is what the sheet pre-fills
/// next time, along with the last quantity entered.
model ChangeOrderPricePref {
  id             String   @id @default(cuid())
  organizationId String
  typeKey        String
  itemKey        String
  unitPrice      Float
  lastQuantity   Float?
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, typeKey, itemKey])
}

model ReviewRequest {
  id             String    @id @default(cuid())
  organizationId String
  // A request hangs off the JOB that was finished or the PROPOSAL that was
  // marked complete — at least one of the two, often both (a job carries its
  // proposal). Both optional since 2026-09-13: a proposal completed by hand
  // with no job behind it still gets a review link.
  jobId          String?
  proposalId     String?
  clientId       String?
  publicToken    String    @unique @default(cuid())
  status         String    @default("PENDING") // PENDING (no client email) | SENT | COMPLETED
  rating         Int?
  comment        String?
  // JSON string[] of photo URLs the client attached (blob URLs; max 6).
  photosJson     String    @default("[]")
  // Contractor hid this review from the public /r/[slug] page and the portal
  // badge. It still counts in the dashboard average and in lead routing.
  hiddenAt       DateTime?
  // The one 7-day reminder was sent (or attempted) — never re-sent.
  remindedAt     DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId, status])
  @@index([jobId])
  @@index([proposalId])
}

model ReferralCode {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  code           String   @unique
  rewardAmount   Float    @default(50)
  rewardType     String   @default("CREDIT") // CREDIT | CASH | DISCOUNT
  note           String?
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions  ReferralConversion[]

  @@index([organizationId])
  @@index([userId])
}

model ReferralConversion {
  id                String    @id @default(cuid())
  codeId            String
  signupEmail       String
  signupOrgId       String?
  status            String    @default("PENDING") // PENDING | CONVERTED | PAID
  note              String?
  createdAt         DateTime  @default(now())
  convertedAt       DateTime?
  // Reward credit tracking — PAID means a 50%-of-one-month Stripe customer-balance
  // credit landed on the referrer org (rewardStripeTxnId). CONVERTED with no
  // rewardAppliedAt = credit pending (referrer has no Stripe customer yet).
  rewardCents       Int?
  rewardAppliedAt   DateTime?
  rewardStripeTxnId String?

  code ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId, status])
  @@index([signupOrgId, status])
}

model TradePost {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String
  title          String
  body           String
  category       String? // equipment | subcontractor | job-share | question
  status         String   @default("OPEN") // OPEN | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  replies      TradeReply[]

  @@index([organizationId, status])
}

model TradeReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post   TradePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
}

// ─────────────────────────────────────────────
// Trade & Services — contractor-to-contractor job network (cross-org, opt-in)
// SQLite-safe: statuses are checked Strings, specialties/tradeTypes are JSON strings.
// ─────────────────────────────────────────────

model TradeNetworkProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  optIn       Boolean  @default(false)
  tradeTypes  String   @default("[]") // JSON string[] of trades this contractor does
  specialties String   @default("[]") // JSON string[] of skills
  serviceArea String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([optIn])
}

model TradeJob {
  id          String   @id @default(cuid())
  authorId    String
  authorOrgId String
  title       String
  description String
  tradeType   String
  specialties String   @default("[]") // JSON string[]
  location    String?
  budget      String?
  timeWindow  String?
  urgency     String? // low | medium | high | urgent
  status      String   @default("OPEN") // OPEN | FILLED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author        User                   @relation("TradeJobAuthor", fields: [authorId], references: [id])
  recipients    TradeJobRecipient[]
  conversations TradeJobConversation[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model TradeJobRecipient {
  id              String    @id @default(cuid())
  tradeJobId      String
  recipientId     String
  status          String    @default("NEW") // NEW | INTERESTED | NOT_INTERESTED
  interestedAt    DateTime?
  notInterestedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tradeJob  TradeJob @relation(fields: [tradeJobId], references: [id], onDelete: Cascade)
  recipient User     @relation("TradeJobRecipientUser", fields: [recipientId], references: [id])

  @@unique([tradeJobId, recipientId])
  @@index([recipientId, status, updatedAt])
}

model TradeJobConversation {
  id          String   @id @default(cuid())
  tradeJobId  String
  authorId    String // job poster
  recipientId String // interested contractor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tradeJob  TradeJob          @relation(fields: [tradeJobId], references: [id], onDelete: Cascade)
  author    User              @relation("TradeJobConvAuthor", fields: [authorId], references: [id])
  recipient User              @relation("TradeJobConvRecipient", fields: [recipientId], references: [id])
  messages  TradeJobMessage[]

  @@unique([tradeJobId, recipientId])
  @@index([authorId])
  @@index([recipientId])
}

model TradeJobMessage {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  conversation TradeJobConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User                 @relation("TradeJobMessageAuthor", fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────
// Stage 2F — Telephony & Advanced AI
// ─────────────────────────────────────────────

model AiPhoneCall {
  id              String    @id @default(cuid())
  organizationId  String
  direction       String    @default("INBOUND") // INBOUND | OUTBOUND
  fromNumber      String
  toNumber        String
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | FAILED
  durationSeconds Int?
  recordingUrl    String?
  transcript      String?
  summary         String?
  leadId          String?
  callSid         String    @unique
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, startedAt])
}

// ─────────────────────────────────────────────
// Calendar — Appointments + Blocked Time
// ─────────────────────────────────────────────

model Appointment {
  id             String   @id @default(cuid())
  organizationId String
  // Linked entity — at most one of lead/client/proposal (enforced in the action).
  leadId         String?
  clientId       String?
  proposalId     String?
  // Who created it — drives the sales-rep calendar scope ("mine or staffed-on-me").
  // Nullable: appointments predating this column have no known creator.
  createdById    String?
  title          String
  status         String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELED | NO_SHOW
  startsAt       DateTime
  endsAt         DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?                   @relation(fields: [leadId], references: [id])
  client       Client?                 @relation(fields: [clientId], references: [id])
  proposal     Proposal?               @relation(fields: [proposalId], references: [id])
  createdBy    User?                   @relation("AppointmentCreator", fields: [createdById], references: [id])
  assignments  AppointmentAssignment[]
  planVisit    ServicePlanVisit?
  report       VisitReport?
  booking      Booking?

  @@index([organizationId, startsAt])
}

// Staff (sales / installers — any WorkerProfile) attached to an appointment.
// Mirrors JobAssignment but without the accept/decline lifecycle: appointment
// staffing is informational, so there is no status column.
model AppointmentAssignment {
  id            String   @id @default(cuid())
  appointmentId String
  workerId      String
  createdAt     DateTime @default(now())

  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, workerId])
}

model BlockedTime {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String? // user it belongs to (vacation, etc); null = whole-org block
  reason         String   @default("Blocked")
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [ownerId], references: [id])

  @@index([organizationId, startsAt])
}

// Recurring weekly unavailability ("every Saturday morning"). One row per
// weekly pattern; minutes-from-midnight bounds keep it timezone-simple and
// SQLite-friendly. Owned by a User (same domain as BlockedTime.ownerId) so it
// covers owners/managers as well as invited workers.
model UnavailabilityRule {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  dayOfWeek      Int // 0 = Sunday … 6 = Saturday
  startMinute    Int // minutes from local midnight, 0–1440
  endMinute      Int
  reason         String   @default("Unavailable")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exceptions   UnavailabilityException[]

  @@index([organizationId, ownerId])
}

// Per-instance override of a recurring rule. `freed = true` means "this
// specific date is open even though the rule blocks it" — the rest of the
// series stays blocked.
model UnavailabilityException {
  id     String   @id @default(cuid())
  ruleId String
  date   DateTime // local midnight of the overridden occurrence
  freed  Boolean  @default(true)

  rule UnavailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
}

// ─────────────────────────────────────────────
// Projects (multi-job grouping)
// ─────────────────────────────────────────────

model Project {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         String    @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | ARCHIVED
  startsAt       DateTime?
  endsAt         DateTime?
  budget         Float     @default(0)
  // The client the project is for (owner, 2026-09-18: "move the client to
  // the project … keep all his proposals under the same project"). Optional:
  // projects made before this, and multi-client builds, carry none.
  clientId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  jobs         Job[]
  proposals    Proposal[]
  budgetLines  ProjectBudgetLine[]
  expenses     ProjectExpense[]

  @@index([organizationId])
  @@index([clientId])
}

// A project's cost budget, one line per category (MATERIALS, LABOR,
// SUBCONTRACTORS, PERMITS, EQUIPMENT, OTHER) or a named line under one.
// Project.budget stays the total the list pages read; the budget actions keep
// it equal to the sum of these lines.
model ProjectBudgetLine {
  id        String   @id @default(cuid())
  projectId String
  category  String
  label     String?
  amount    Float    @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// A cost logged straight to a project (a permit, a dumpster, a sub's invoice)
// rather than to one of its jobs. Spent-to-date on the budget is these plus
// the JobExpense rows of the project's jobs.
model ProjectExpense {
  id          String   @id @default(cuid())
  projectId   String
  category    String
  amount      Float
  vendor      String?
  note        String?
  spentAt     DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, spentAt])
}

// ─────────────────────────────────────────────
// Applicants (hiring)
// ─────────────────────────────────────────────

model Applicant {
  id             String   @id @default(cuid())
  organizationId String
  fullName       String
  email          String
  phone          String?
  role           String
  status         String   @default("APPLIED") // APPLIED | INTERVIEWING | HIRED | REJECTED
  source         String?
  notes          String?
  resumeUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ─────────────────────────────────────────────
// Influencer / affiliate
// ─────────────────────────────────────────────

model InfluencerPayout {
  id             String    @id @default(cuid())
  organizationId String
  influencerName String
  amount         Float
  status         String    @default("PENDING") // PENDING | PAID | FAILED
  period         String
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// DEPRECATED (kept read-only for the legacy /dashboard/trade view): these are
// org-scoped, name-keyed and carry no Stripe attribution. The platform-scoped
// Influencer/PromoCode/Attribution/CommissionLedger models below supersede them.
model InfluencerStatement {
  id             String   @id @default(cuid())
  organizationId String
  influencerName String
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  earnings       Float    @default(0)
  period         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, period])
}

// ─────────────────────────────────────────────
// Admin console — Stripe-truth influencer / promo / commission / payouts.
// Money is integer cents. Stripe is the source of truth; these tables cache it
// and are fully rebuildable from Stripe via webhooks + reconciliation.
// ─────────────────────────────────────────────

// A platform influencer/affiliate. Optionally linked to a User login; otherwise
// authenticates via its own credentials (separate influencer login surface).
model Influencer {
  id               String   @id @default(cuid())
  userId           String?  @unique
  email            String   @unique
  displayName      String
  hashedPassword   String? // set when the influencer logs in via the separate surface
  sessionVersion   Int      @default(0) // bumped on every password change; a JWT issued before the bump is refused (lib/orgContext.requireInfluencer)
  status           String   @default("PENDING") // InfluencerStatus
  connectAccountId String?  @unique // Stripe Connect acct_...
  connectStatus    String   @default("NONE") // ConnectStatus (mirror of account state)
  payoutsEnabled   Boolean  @default(false) // mirror of account.payouts_enabled
  defaultCurrency  String   @default("usd")
  minPayoutCents   Int      @default(2500) // payout request threshold
  holdDays         Int      @default(30) // escrow window before commission clears
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  promoCodes     PromoCode[]
  attributions   Attribution[]
  ledgerEntries  CommissionLedger[]
  payoutRequests PayoutRequest[]
  transfers      PayoutTransfer[]

  @@index([status])
  @@index([connectAccountId])
}

// A Stripe coupon/promotion code owned by an influencer, plus OUR per-code
// commission rule (Stripe knows the customer discount; the payout rate is ours).
model PromoCode {
  id                    String   @id @default(cuid())
  influencerId          String
  stripeCouponId        String // coupon_...
  stripePromotionCodeId String   @unique // promo_...
  code                  String   @unique // redeemable string, e.g. JAMIE20
  active                Boolean  @default(true)
  commissionType        String // CommissionType: PERCENT | FLAT
  commissionRateBps     Int? // basis points when PERCENT (2000 = 20%)
  commissionFlatCents   Int? // flat cents when FLAT
  commissionBasis       String   @default("NET") // CommissionBasis
  durationType          String   @default("REPEATING") // PromoDurationType
  durationMonths        Int? // required when REPEATING
  customerPercentOff    Int? // display mirror of the Stripe coupon percent_off
  clicks                Int      @default(0) // promo-link landing visits (lightweight, no PII)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  influencer          Influencer     @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  attributions        Attribution[]
  signupOrganizations Organization[] @relation("OrgSignupPromo")

  @@index([influencerId])
  @@index([stripeCouponId])
}

// One row per Stripe subscription that ever carried a qualifying discount.
// Created ONLY from a Stripe-issued object (subscription/invoice), never from
// pre-checkout frontend intent — abandoned checkouts produce no attribution.
model Attribution {
  id                   String    @id @default(cuid())
  influencerId         String
  promoCodeId          String
  organizationId       String? // resolved via the Subscription mirror
  stripeCustomerId     String // cus_...
  stripeSubscriptionId String    @unique // sub_... — one attribution per subscription
  status               String    @default("ACTIVE") // AttributionStatus
  firstPaidInvoiceAt   DateTime?
  qualifyingMonths     Int       @default(0) // accrual counter for ONCE/REPEATING caps
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  influencer    Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  promoCode     PromoCode          @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  ledgerEntries CommissionLedger[]

  @@index([influencerId, status])
  @@index([stripeCustomerId])
}

// Append-only financial truth. Signed integer cents; balance = SUM(amountCents).
// idempotencyKey @unique is the linchpin against double-accrual across webhook
// retries and reconciliation re-runs.
model CommissionLedger {
  id               String    @id @default(cuid())
  influencerId     String
  attributionId    String? // null for PAID / ADJUSTMENT (span many attributions)
  entryType        String // LedgerEntryType
  amountCents      Int // signed: ACCRUED +, REVERSED/PAID -
  currency         String    @default("usd")
  stripeInvoiceId  String? // in_...
  stripeChargeId   String? // ch_... (refund clawback source)
  stripeEventId    String? // evt_...
  clearsAt         DateTime? // ACCRUED clears after holdDays
  state            String    @default("PENDING") // LedgerEntryState
  payoutTransferId String?
  idempotencyKey   String    @unique // accrue:<invoiceId> / reverse:<chargeId>:<refundId> / pay:<transferId>:<entryId>
  memo             String?
  createdAt        DateTime  @default(now())

  influencer  Influencer      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  attribution Attribution?    @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  transfer    PayoutTransfer? @relation(fields: [payoutTransferId], references: [id], onDelete: SetNull)

  @@index([influencerId, state])
  @@index([stripeInvoiceId])
  @@index([attributionId])
}

// Influencer-initiated payout request; snapshots the cleared balance at request
// time. Admin approves, then a cron processes it into a PayoutTransfer.
model PayoutRequest {
  id             String    @id @default(cuid())
  influencerId   String
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("PENDING") // PayoutRequestStatus
  requestedBy    String? // admin userId or null (auto)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  periodLabel    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  influencer Influencer       @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  transfers  PayoutTransfer[]

  @@index([influencerId, status])
}

// A Stripe Connect transfer of cleared commission to an influencer's account.
model PayoutTransfer {
  id                     String    @id @default(cuid())
  influencerId           String
  payoutRequestId        String?
  amountCents            Int
  currency               String    @default("usd")
  status                 String    @default("PENDING") // PayoutTransferStatus
  stripeTransferId       String?   @unique // tr_...
  stripeConnectAccountId String // acct_... destination
  failureReason          String?
  idempotencyKey         String    @unique // passed to stripe.transfers.create
  createdAt              DateTime  @default(now())
  paidAt                 DateTime?

  influencer    Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  payoutRequest PayoutRequest?     @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)
  ledgerEntries CommissionLedger[]

  @@index([influencerId, status])
}

// Idempotency log for inbound Stripe webhooks — eventId @unique drops replays.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("STRIPE") // STRIPE | SQUARE
  eventId     String // evt_... / Square event_id
  type        String
  status      String    @default("RECEIVED") // WebhookEventStatus
  payloadHash String?
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([type, receivedAt])
  @@index([provider, receivedAt])
}

// Stripe Price mirror. At most one active price per (plan, interval). Stripe
// Prices are immutable, so editing a price archives the old and points here.
// entitlements.ts remains the feature-gate source of truth.
model PlanPrice {
  id              String   @id @default(cuid())
  planSlug        String // matches PLAN_TIERS (lowercased)
  interval        String // BillingInterval: MONTH | YEAR
  stripeProductId String // prod_...
  stripePriceId   String   @unique // price_... (active price)
  unitAmountCents Int
  currency        String   @default("usd")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  // "At most one active price per (plan, interval)" is enforced in the
  // repoint transaction (archive old → insert new), not by a DB constraint:
  // SQLite has no partial unique index, and many archived rows must coexist.
  @@index([planSlug, interval, active])
}

// Watermarks for the Stripe reconciliation backstop (list cursors per resource).
model SyncState {
  key       String   @id
  cursor    String
  updatedAt DateTime @updatedAt
}

// One row per letter handed to lib/sdk/resend sendEmail (2026-10-21) — sent,
// failed after the retries, or skipped (QA test mode, preview guard, dev
// outbox, no transport) — so "the code never came" can be told apart from
// "the letter left". Written after the response (lib/emailLog), never in the
// way of a send. `to` is lowercased, several addresses joined by ", ". No
// relation to Organization: a deleted company's rows age out with the rest
// (daily-cleanup drops rows older than 90 days). Read by /admin/mail/log,
// /admin/health and the daily-limit alert.
model EmailLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  to             String
  subject        String
  kind           String   @default("other") // lib/emailLog EMAIL_KINDS
  transport      String // smtp | resend | skipped
  status         String // sent | failed | skipped
  providerId     String? // SMTP Message-ID, Resend id, or the skip's marker
  error          String? // the last attempt's error, at most 500 chars
  durationMs     Int      @default(0)
  organizationId String?

  @@index([createdAt])
  @@index([to])
  @@index([kind])
  @@index([status])
}

// Persistent price-lookup cache for the estimator. Keyed on a normalized query
// (see normalizeSearchQuery) + location so a repeated lookup reuses a prior
// fetch when the price source (SerpAPI) is down. productsJson is a JSON-encoded
// product[] string (SQLite-safe / Postgres-portable, matching the schema-wide
// "JSON stored as String" convention). A daily cron prunes stale rows.
model ProductPriceCache {
  id              String   @id @default(cuid())
  normalizedQuery String
  location        String?
  productsJson    String
  source          String?
  currency        String   @default("usd")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([normalizedQuery, location])
  @@index([updatedAt])
}

// ReportAll USA parcel cache. The account quota is ALLTIME (1000 parcels for
// the life of the key), so every fetched parcel is kept forever, keyed on
// ReportAll's stable robust_id. `wkt` is the raw MULTIPOLYGON in EPSG:4326 —
// parsed on read by src/lib/parcels.ts, stored verbatim so nothing is lost.
model ParcelCache {
  robustId   String   @id
  parcelId   String?
  owner      String?
  address    String?
  // Upper-cased, whitespace-collapsed `address` — the key the address lookup
  // matches on. Equality, never `contains`/`mode: insensitive`: SQLite LIKE is
  // case-insensitive while Postgres LIKE is not, and `mode: "insensitive"` does
  // not exist on SQLite, so the only form that behaves identically on the dev
  // and production engines is exact equality over a pre-normalised column.
  addressKey String?
  city       String?
  zip        String?
  acreage    Float?
  wkt        String
  lat        Float
  lon        Float
  fetchedAt  DateTime @default(now())
  // The assessor's record (2026-09-16): null on rows cached before the client
  // read these fields; `enrichedAt` says whether a row was ever fetched with
  // them, so a stale row can be refreshed once instead of guessed at.
  bldgSqft      Float?
  yearBuilt     Int?
  storeys       Float?
  buildingCount Int?
  countyName    String?
  stateAbbr     String?
  landUseClass  String?
  buildingsJson String?   // JSON array of WKT polygons
  enrichedAt    DateTime?

  @@index([addressKey])
}

// Negative cache: points that returned zero parcels. Key is "lat,lon" rounded
// to 5 decimals (~1.1 m), TTL 7 days — repeated clicks on the same lake do not
// burn the ALLTIME quota, but coverage that appears later is eventually seen.
model ParcelMiss {
  key       String   @id
  checkedAt DateTime @default(now())
}

// One EagleView Property Data ("Instant") order. A row is written THE MOMENT
// EagleView accepts the order — before the first poll — because from that
// moment the lookup is billable whether or not we wait for the result. A poll
// timeout therefore no longer loses the paid result: the requestId is here and
// result/{id} can be asked again later. Also the idempotency ledger: a repeat
// measurement of the same address reuses a complete row or resumes a pending
// one instead of ordering (and paying) again.
/// Which measurement's satellite photo a proposal shows its client — the
/// house on the portal page and the PDF (2026-09-13). Bare ids, no relations,
/// so the table can land on its own; a missing table just means no photo.
model ProposalSitePhoto {
  id                String   @id @default(cuid())
  proposalId        String   @unique
  roofMeasurementId String
  createdAt         DateTime @default(now())
}

/// The organization's own roof catalog for the package builder: its roof
/// types and underlayments with prices, plus the builder's standing
/// preferences (selections and unit prices for everything else). One JSON
/// document per org, written whole by saveRoofCatalog. Like InstantOrder,
/// bare organizationId — no relation — so the table can land on its own.
model RoofCatalog {
  id             String   @id @default(cuid())
  organizationId String   @unique
  catalogJson    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// The organization's fence price book and its own fence types
/// (lib/fence/catalogSchema.ts), one JSON document per org — the same
/// shape as RoofCatalog. Read in try/catch: the fence page prices on the
/// catalog's national rates until the table exists (2026-09-18).
model FenceCatalog {
  id             String   @id @default(cuid())
  organizationId String   @unique
  catalogJson    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Platform-wide Smart Proposal prompt overrides, edited on /admin/prompts
/// (2026-09-18). `key` is one of: master, system, procedure-rules,
/// specialty:<id>:preamble, specialty:<id>:procedure. A missing row means the
/// code default applies; the estimate pipeline reads the table in try/catch
/// so an environment without it prices on the defaults.
model PromptOverride {
  key       String   @id
  body      String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstantOrder {
  id             String   @id @default(cuid())
  organizationId String
  // Upper-cased, whitespace-collapsed "address|city|state|zip" (equality only,
  // same reasoning as ParcelCache.addressKey).
  addressKey     String
  address        String?
  requestId      String   @unique
  // pending | complete | failed
  status         String   @default("pending")
  // The parsed InstantRoofData once retrieved; null while pending/failed.
  instantJson    String?
  // The response body EXACTLY as EagleView sent it, kept because the parser
  // reads 31 paths and drops the rest — every field's confidence, the
  // roof-material polygon, the occlusion classifiers. Two paid lookups were
  // already lost this way and can never be re-examined. One row per paid
  // order, so this is the audit trail of what was actually bought; null for
  // orders placed before 2026-08-28 and for ones that never completed.
  instantRawJson String?
  error          String?
  // JSON array of the Property Data pack ids this order asked for
  // (["property_data_id_001", …]). Since 2026-09-08 an address is bought pack
  // by pack when the account's entitlement is partial, so one address can
  // have several complete rows that together make one answer. Null on rows
  // from before that: those were single seven-pack orders.
  packs          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([addressKey, status])
}

/// Which EagleView Property Data packs the ACCOUNT may order — a fact about
/// the credentials, not about any address, which is why it is not scoped to
/// an organization. `denied` is EagleView's 403 / 10880 ("no active
/// entitlement") on a single-pack order; a 403 costs nothing, so a denied pack
/// is probed again once its record is older than a day. `live` is an accepted
/// order. A pack with no row has never been probed. Reset by
/// scripts/eagleview-recheck-entitlements.ts.
model EagleViewEntitlement {
  // property_data_id_001 … property_data_id_009
  pack      String   @id
  // live | denied
  status    String
  checkedAt DateTime @default(now())
  error     String?
}

/// Google Solar answers for one place, frozen so a second measurement of the
/// same address never depends on Google answering twice.
///
/// NOT organization-scoped, unlike InstantOrder: an Instant lookup is billed to
/// an org and its ledger row is that org's receipt, while Solar imagery is a
/// property of the PLACE. Two orgs measuring the same house should share it.
///
/// The rasters are held as gzipped little-endian float32, the same wire format
/// the QA fixtures use (dsm.f32.gz / mask.f32.gz), about 1.2 MB each.
model SolarCache {
  id         String   @id @default(cuid())
  /// Upper-cased, whitespace-collapsed address, or `@lat,lng` rounded to ~1 m
  /// when the caller had only a pin. Same normalisation as the Instant ledger.
  addressKey String   @unique
  lat        Float
  lng        Float

  /// DataLayerUrls as returned, minus nothing — the URLs are re-keyed on use.
  layersJson String
  /// BuildingInsights, when Google answered; its failure is non-fatal upstream.
  insightsJson String?

  /// Raster metadata (width/height/pixelSizeM/originX/originY/epsg) …
  dsmMetaJson  String
  maskMetaJson String
  /// … and the pixels, gzipped float32.
  dsmData      Bytes
  maskData     Bytes

  /// Google's own capture date for this tile, surfaced to the user.
  imageryDate String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lat, lng])
}

// ── HVAC estimator (2026-09-15) ───────────────────────────────────────────
// Three tables, none related: the estimator reads them in try/catch and runs
// on defaults until `prisma db push` has created them (same deploy rule as
// RoofCatalog). Every column the engine reads is JSON-as-String, so the
// building model, engine result and priced draft can grow without a schema
// change.

model HvacEstimate {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  address        String
  state          String?
  county         String?
  status         String   @default("draft") // draft | converted
  siteFactsJson  String
  modelJson      String
  engineJson     String
  draftJson      String
  /// The permit-grade Manual J report (Cool Calc), once one is attached.
  approvedReportUrl String?
  /// Cool Calc project/system ids and the report endpoint, JSON (2026-09-15).
  permitJson     String?
  /// What was actually quoted or installed, JSON {tons, price, model, notes} — the calibration loop.
  actualJson     String?
  /// The engine's nominal size when saved (tons × systems), for calibration without parsing engineJson.
  sizedTons      Float?
  /// What was priced (src/lib/hvac/jobs.ts): replace-system, water-heater, …
  jobKind        String?
  proposalId     String?
  subtotal       Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
}

model HvacCatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String   // stable key from the import (kind-brand-model)
  kind           String
  brand          String
  model          String
  itemJson       String   // the CatalogItem, whole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, itemId])
  @@index([organizationId, kind])
}

model HvacSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  rateCardJson   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── WAREHOUSE STOCK (2026-09-20) ─────────────────────────────────────────────
// Owner: the fence, roof and HVAC companies keep their own stock — posts,
// concrete, boards, shingles, underlayment, equipment — and the proposals
// should draw on it: forecast while open, reserved once sold, taken out when
// the crew loads the truck, with a warning before it runs short and a
// purchase order to the supplier. One warehouse per company.

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  website        String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InventoryItem[]

  @@index([organizationId])
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  /// "fence" | "roof" | "hvac"
  trade          String
  name           String
  /// The name normalized for matching a proposal line to this item.
  key            String
  unit           String   @default("each")
  onHand         Float    @default(0)
  /// Warn when available stock falls under this; null = the next job's need.
  reorderPoint   Float?
  supplierId     String?
  supplierSku    String?
  lastCost       Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements    InventoryMovement[]

  @@unique([organizationId, trade, key])
  @@index([organizationId, trade])
}

model InventoryMovement {
  id         String   @id @default(cuid())
  itemId     String
  /// RECEIVED | PICKED | USED | RETURNED | ADJUST
  kind       String
  /// Signed: received and returned add, picked and used take away.
  quantity   Float
  jobId      String?
  proposalId String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())
  /// The unit price the movement moved at (stage D, 2026-09-30): stamped from
  /// the item's lastCost when stock is issued to a job or returned, so a job's
  /// cost does not drift when the price changes later. Null on older rows —
  /// they read the item's lastCost, else 0 (lib/jobCost).
  unitCost   Float?

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([jobId])
}

// ── SERVICE PLANS / MEMBERSHIPS (2026-09-22) ─────────────────────────────────
// A plan template is what the shop sells (visits a year, price, discount,
// benefits); a ServicePlan is one client's membership — a snapshot of the
// terms at signing, its visits, and the invoices that bill it.

model ServicePlanTemplate {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  trade              String   @default("hvac")
  visitsPerYear      Int      @default(2)
  termMonths         Int      @default(12)
  priceCents         Int
  billing            String   @default("MONTHLY") // MONTHLY | YEARLY
  discountPct        Int      @default(0)
  benefitsJson       String   @default("[]")
  priorityScheduling Boolean  @default(true)
  waivedDiagnostic   Boolean  @default(false)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plans        ServicePlan[]

  @@index([organizationId])
}

model ServicePlan {
  id                 String    @id @default(cuid())
  organizationId     String
  templateId         String?
  clientId           String
  status             String    @default("DRAFT") // DRAFT | SENT | ACTIVE | EXPIRED | CANCELED
  name               String
  description        String?
  trade              String    @default("hvac")
  visitsPerYear      Int
  termMonths         Int
  priceCents         Int
  billing            String // MONTHLY | YEARLY
  discountPct        Int       @default(0)
  benefitsJson       String    @default("[]")
  priorityScheduling Boolean   @default(true)
  waivedDiagnostic   Boolean   @default(false)
  propertyAddress    String?
  startsAt           DateTime?
  endsAt             DateTime?
  nextBillingAt      DateTime?
  autoRenew          Boolean   @default(true)
  acceptToken        String    @unique @default(cuid())
  sentAt             DateTime?
  acceptedAt         DateTime?
  acceptedName       String?
  canceledAt         DateTime?
  expiringNoticedAt  DateTime?
  renewedFromId      String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     ServicePlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  visits       ServicePlanVisit[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([organizationId, endsAt])
  @@index([organizationId, nextBillingAt])
}

model ServicePlanVisit {
  id             String    @id @default(cuid())
  organizationId String
  planId         String
  seq            Int
  label          String
  dueAt          DateTime
  status         String    @default("SCHEDULED") // SCHEDULED | DONE | SKIPPED
  appointmentId  String?   @unique
  doneAt         DateTime?
  remindedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         ServicePlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  report       VisitReport?

  @@index([organizationId, dueAt])
  @@index([planId])
}

// ── EQUIPMENT ON FILE, VISIT REPORTS, ONLINE BOOKING (2026-09-23) ────────────

// What is installed at a client's home: typed, read off a nameplate photo,
// filed by the HVAC estimator on conversion, or noted by the crew on a visit.
model ClientEquipment {
  id                 String    @id @default(cuid())
  organizationId     String
  clientId           String
  kind               String // split-ac-furnace | split-heat-pump | furnace-only | package-unit | ductless | water-heater | boiler | other
  label              String?
  brand              String?
  model              String?
  serial             String?
  tons               Float?
  refrigerant        String?
  fuel               String? // gas | propane | electric | oil
  yearMade           Int?
  installedAt        DateTime?
  warrantyPartsUntil DateTime?
  warrantyLaborUntil DateTime?
  filterSize         String?
  location           String?
  notes              String?
  source             String    @default("typed") // typed | nameplate | estimator | visit
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
}

// The crew's tune-up / visit report: readings, findings, what the client
// should hear — sent by email and readable on a public page.
model VisitReport {
  id              String    @id @default(cuid())
  organizationId  String
  appointmentId   String    @unique
  clientId        String?
  planVisitId     String?   @unique
  techName        String?
  kind            String    @default("both") // cooling | heating | both | other
  readingsJson    String    @default("{}")
  findingsJson    String    @default("[]")
  recommendations String?
  summary         String?
  publicToken     String    @unique @default(cuid())
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  planVisit    ServicePlanVisit? @relation(fields: [planVisitId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// A visit booked online at /book/<slug>: the customer's words, the slot, the
// appointment it became, and the manage link they can move or cancel it with.
model Booking {
  id             String    @id @default(cuid())
  organizationId String
  appointmentId  String?   @unique
  leadId         String?
  clientId       String?
  serviceKey     String
  serviceLabel   String
  minutes        Int
  status         String    @default("BOOKED") // BOOKED | RESCHEDULED | CANCELED | DONE
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  answersJson    String    @default("[]")
  member         Boolean   @default(false)
  manageToken    String    @unique @default(cuid())
  startsAt       DateTime
  endsAt         DateTime
  remindedAt     DateTime?
  canceledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
}

// ─── TEXT MESSAGES (2026-09-24) ─────────────────────────────────────────────
// JobFlex owns the Twilio account; a contractor only adds phone numbers.
// docs/sms.md.

/// An extra office number that gets every office text (the dispatcher, the
/// spouse who runs the books) — beside the members' own verified mobiles.
model NotificationPhone {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// A six-digit code on its way to a member's mobile. One live row per user.
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Every text, out and in: the usage counter, the delivery status from
/// Twilio's callback, the overnight hold (HELD until sendAfter), replies.
model SmsMessage {
  id             String    @id @default(cuid())
  organizationId String?
  direction      String    @default("OUT") // OUT | IN
  to             String
  from           String?
  body           String
  kind           String? // a preference key, "crew-assigned", "crew-digest-today", "verify", "welcome", "reply", …
  status         String    @default("QUEUED") // QUEUED | HELD | SENT | DELIVERED | FAILED | UNDELIVERED | SKIPPED | MERGED | RECEIVED
  sendAfter      DateTime?
  sid            String?   @unique
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, createdAt])
  @@index([to, createdAt])
  @@index([status, sendAfter])
}

/// A number that replied STOP. Twilio blocks it on its side too; this row is
/// what the app checks before every send and shows in Settings.
model SmsOptOut {
  phone     String   @id
  stoppedAt DateTime @default(now())
  body      String?
}

/// A platform-wide integration the admin sets up once for everyone
/// (2026-09-24): `json` is a secretBox-encrypted blob. Key "twilio" holds
/// { accountSid, authToken, messagingServiceSid, fromNumber, enabled }.
/// Env vars remain the fallback when there is no row.
model PlatformIntegration {
  key         String   @id
  json        String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ── TRIAL WATCH (2026-09-24) ──────────────────────────────────────────────
// Who looked at what during a company's first weeks: one row per page a
// signed-in member opens (the route pattern, never the query string), so the
// admin's Trial watch can tell a contractor working from a visitor touring
// the product to copy it. Written fire-and-forget by actions/pageView, which
// also prunes rows older than 120 days; read by actions/trialWatch. No
// relation to Organization on purpose: an unrelated table reaches production
// without touching any table the app already reads.
model PageView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  /// "/dashboard/jobs/*" — ids collapsed, query dropped (lib/trialWatch routePattern).
  route          String
  /// First 16 hex of sha256(client address) and of sha256(user agent): the same device across two trials, no address kept.
  ipHash         String?
  uaHash         String?
  at             DateTime @default(now())

  @@index([organizationId, at])
  @@index([uaHash, ipHash, at])
}

/// Your own texts (2026-09-29): a company's own rule — WHEN something happens
/// (or so many hours before a visit / days after a job), WHO hears it, WHAT it
/// says with {fields} filled from the job. lib/sms/textRules (the catalog,
/// pure) and lib/sms/rulesEngine (the sends). No relation back to anything
/// the app already reads, so the table reaches production on its own.
model TextRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// lib/sms/textRules RuleTriggerKey — "proposal.accepted", "appointment.before", …
  trigger        String
  /// Timed triggers: hours before / days after; null for the moment itself.
  offset         Int?
  toClient       Boolean  @default(false)
  toOffice       Boolean  @default(false)
  toRep          Boolean  @default(false)
  toCrew         Boolean  @default(false)
  /// Named members, a JSON array of user ids.
  toUserIdsJson  String?
  body           String
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, trigger])
}
