// JobFlex Prisma schema — SQLite for local dev. Vercel builds swap this
// datasource block to Neon Postgres via scripts/prisma-production-schema.js
// (see vercel.json). Keep this block SQLite: flipping it to postgresql breaks
// `prisma generate` locally (postinstall + build) and every runtime query,
// because .env.local points DATABASE_URL at file:./dev.db.
// Enums moved to src/lib/prismaEnums.ts; string[] stored as JSON-encoded strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Tenancy + Auth
// ─────────────────────────────────────────────

model Organization {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  logoUrl               String?
  primaryColor          String?
  billingEmail          String?
  phone                 String?
  address               String?
  website               String?
  timezone              String    @default("America/New_York")
  // Text messages (2026-09-24): client-facing texts on/off (the proposal link
  // when sent, a reminder the day before a visit), and the company's own
  // number when it claimed one (provisioned into the platform's Messaging
  // Service, so it stays registered; released from Settings or /admin).
  smsClientsOn          Boolean   @default(true)
  smsFromNumber         String?
  smsNumberSid          String?
  // Online booking (2026-09-23): hours, slot length, lead time, crews, the services offered.
  bookingSettingsJson   String?
  defaultTaxRate        Float     @default(0)
  // Org-wide default profit markup (hidden from the client). Seeded into a new
  // proposal's per-proposal materialMarkupPct/laborMarkupPct at creation; the
  // contractor can override per proposal. @default(0) = existing orgs keep 0%
  // (current behaviour — no price change), so no backfill is needed.
  materialMarkupPct     Float     @default(0)
  laborMarkupPct        Float     @default(0)
  aiPromptCustom        String?
  publicProfileEnabled  Boolean   @default(false)
  landingHeroTitle      String?
  landingHeroSubtitle   String?
  heroImageUrl          String?
  servicesJson          String?
  // Settings persistence — one JSON-as-String blob per settings page (hydrated whole on load).
  paymentSettingsJson   String? // settings/payment  {stripe,square,paypal,ach,currency,depositPct,netTerms,lateFeePct,autoRemind,lateFees}
  leadsSettingsJson     String? // settings/leads     {strategy,zips[],travelRadius,maxPerDay,maxPerRep,aiCategorize,instantSms,businessHours}
  gmailSettingsJson     String? // settings/gmail     {sendFromUser,trackOpens,autoSync,displayName,replyTo,signature}
  gmailTokensJson       String? // OAuth secrets      {accessToken,refreshToken,expiryDate,email} — set by the Gmail connect callback
  metaSettingsJson      String? // settings/meta      {connected,autoCreate,autoText,defaultPage,formCategory}
  proposalSettingsJson  String? // settings/proposals {validityDays,markups{...},schedule[],terms,requireSig,autoFollowUp}
  // Lead Center matching profile — canonical TRADE_TYPES multi-select (JSON string[],
  // closed vocabulary from src/lib/tradeTypes.ts; distinct from the free-text Specialty
  // model which steers AI estimator prompts). lat/lng geocoded from `address` at
  // register/profile-save; orgs without coords are ineligible for platform lead offers.
  tradeTypesJson        String?   @default("[]")
  // Free text typed under the register form's "Other" trade chip. Deliberately
  // NOT folded into tradeTypesJson: that column is validated against the closed
  // TRADE_TYPES vocabulary (src/lib/tradeTypes.ts) and anything unrecognised is
  // dropped on read, so a custom trade needs a column of its own to survive.
  otherTrade            String?
  lat                   Float?
  lng                   Float?
  geocodedAt            DateTime?
  leadOffersEnabled     Boolean   @default(true)
  // How far from the shop a homeowner's job may be for the Lead Center to
  // offer it (2026-10-03): the cascade and the admin's hand-send list keep to
  // it, measured lead pin → shop pin. The shop sets it on the Company page.
  serviceRadiusMiles    Int       @default(50)
  // JobFlex's own organizations (QA Co, the owner's): the only ones a TEST
  // platform lead may be sent to. Flipped in the admin Lead Center.
  isInternal            Boolean   @default(false)
  // Pre-signup attribution stamp (first-write-wins: set once at account creation,
  // never overwritten). The money record stays Stripe-truth (Attribution model);
  // this is captured intent used for the signup pill + checkout auto-apply.
  signupPromoCode       String?
  signupPromoCodeId     String?
  attributionCapturedAt DateTime?
  // Where the signup CAME FROM (CRO stage 1, 2026-09-09): the trade hero the
  // visitor landed on (`?industry=` on the landing, a TRADE_TYPES value) and
  // the visit's utm_* — copied from the pending signup record when the
  // organization is created, first-write-wins, never overwritten. Advisory:
  // tradeTypesJson is what the owner chose; this is what the ad promised.
  landingIndustry       String?
  // landing-e's test variant ("e"), null for every other signup (pass A,
  // 2026-09-11). Read by the Overview's first-run card and Admin → Traffic.
  signupVariant         String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  // What the signup remembered for Meta's Conversions API: consent, fbp/fbc,
  // IP and UA, the browser's event ids. JSON. No longer written since the
  // Conversions API was removed (2026-10-17); kept for the rows that have it.
  metaSignupJson        String?
  // Soft delete (Settings → Danger zone). A deleted org is invisible to
  // requireOrg() and every public surface at once; the purge cron hard-deletes
  // (cascade) 30 days later. deletedById = the owner who confirmed.
  deletedAt             DateTime?
  deletedById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships          Membership[]
  paymentConnections   PaymentConnection[]
  invites              Invite[]
  clients              Client[]
  leads                Lead[]
  proposals            Proposal[]
  templates            ProposalTemplate[]
  jobs                 Job[]
  jobEvents            JobEvent[]
  workDays             WorkDay[]
  workerProfiles       WorkerProfile[]
  payments             Payment[]
  invoices             Invoice[]
  activities           ActivityEvent[]
  conversations        Conversation[]
  announcements        Announcement[]
  emailTemplates       EmailTemplate[]
  followUpRules        FollowUpRule[]
  followUps            FollowUp[]
  aiDrafts             AiDraft[]
  aiPromptPacks        AiPromptPack[]
  aiEstimates          AiEstimate[]
  tags                 Tag[]
  subscription         Subscription?
  supportTickets       SupportTicket[]
  specialties          Specialty[]
  homeownerReqs        HomeownerRequest[]
  leadOffers           LeadOffer[]
  changeOrders         ChangeOrder[]
  reviewRequests       ReviewRequest[]
  referralCodes        ReferralCode[]
  tradePosts           TradePost[]
  phoneCalls           AiPhoneCall[]
  notificationPhones   NotificationPhone[]
  appointments         Appointment[]
  blockedTimes         BlockedTime[]
  unavailabilityRules  UnavailabilityRule[]
  projects             Project[]
  applicants           Applicant[]
  influencerPayouts    InfluencerPayout[]
  influencerStatements InfluencerStatement[]
  eagleViewReports     EagleViewReport[]
  roofMeasurements     RoofMeasurement[]
  overheads            MonthlyOverhead[]
  suppliers            Supplier[]
  inventoryItems       InventoryItem[]
  servicePlanTemplates ServicePlanTemplate[]
  servicePlans         ServicePlan[]
  servicePlanVisits    ServicePlanVisit[]
  clientEquipment      ClientEquipment[]
  visitReports         VisitReport[]
  bookings             Booking[]
  // Why a plan was cancelled, and asks for more trial days (2026-10-20).
  cancellationFeedback CancellationFeedback[]
  trialExtensionRequests TrialExtensionRequest[]
  // Every declined plan charge, for /admin/revenue/failed-payments (2026-10-21).
  paymentFailures      PaymentFailure[]
  signupPromo          PromoCode?            @relation("OrgSignupPromo", fields: [signupPromoCodeId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([signupPromoCodeId])
  @@index([deletedAt])
}

// One month's recurring business cost sheet — the costs that exist whether or
// not a single job runs. Keyed by calendar month (year + month 1-12) rather
// than a DateTime so the record IS the month, with no timezone to get wrong.
//
// Eight fixed categories, plus three that scale: workers / sales / marketing
// are entered either as flat dollars or as a percent of that month's revenue,
// chosen by the matching *Pct flag. The dollars-vs-percent split is what lets
// the Overhead tab report a fixed total and a variable total separately.
model MonthlyOverhead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  month          Int

  // FIXED — flat dollars, unmoved by revenue.
  rent      Float @default(0)
  office    Float @default(0)
  insurance Float @default(0)
  vehicles  Float @default(0)
  software  Float @default(0)
  warehouse Float @default(0)
  utilities Float @default(0)
  other     Float @default(0)

  // SCALING — amount is dollars when the flag is false, a percent of the
  // month's revenue when it is true.
  workers      Float   @default(0)
  workersPct   Boolean @default(false)
  sales        Float   @default(0)
  salesPct     Boolean @default(false)
  marketing    Float   @default(0)
  marketingPct Boolean @default(false)

  // The contractor's own fixed lines beyond the eight above — a yard lease, a
  // bookkeeper, a storage unit. JSON-as-String: [{ "id", "label", "amount" }].
  // Fixed only: a custom line never scales with revenue.
  customJson String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, year, month])
  @@index([organizationId])
}

// Cached EagleView roof-measurement reports. A report is a billable order, so we
// fetch + parse it once and reuse the result. modelJson holds the parsed
// RoofModel geometry (points/lines/faces); summaryJson the raw GetReport header.
model EagleViewReport {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportId         Int
  status           String       @default("In Process")
  statusId         Int?
  address          String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  productId        Int?
  totalCost        Float?
  // Headline measurements (parsed from geometry; mirror EagleView's summary).
  areaSqft         Float?
  squares          Float?
  predominantPitch String?
  facetCount       Int?
  // JSON-as-String (SQLite): parsed RoofModel geometry + raw GetReport summary.
  modelJson        String?
  summaryJson      String?
  orderedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, reportId])
  @@index([organizationId])
}

// Saved roof measurements from the Instant flow: EagleView Property Data
// (numbers, outline, flags, imagery) merged with the aerial reconstruction
// (facet geometry) and calibrated to it. Instant results carry a UUID rather
// than a reportId and every lookup is billed, so the merged result is persisted
// once here and re-opened from history, the proposal and the handheld page.
model RoofMeasurement {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById      String?
  // instant+recon | instant-outline | recon
  source           String
  address          String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  // Headline figures (Instant's when present, else the reconstruction's).
  areaSqft         Float?
  squares          Float?
  predominantPitch String?
  facetCount       Int?
  instantRequestId String?
  // JSON-as-String (SQLite): Instant summary, calibrated RoofModel, chimney
  // candidates, calibration report + imagery provenance.
  instantJson      String?
  modelJson        String
  chimneyJson      String?
  provenanceJson   String?
  // Exported drawing (Vercel Blob), filled by the export batch.
  pngUrl           String?
  pdfUrl           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, createdAt])
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  image                 String?
  hashedPassword        String?
  emailVerified         DateTime?
  locale                String?
  // Contact + preferences owned by the PERSON, not the org: the settings
  // Profile card's phone, and the notification matrix (channel toggles per
  // event, quiet hours, digest time) as one JSON-as-String blob, hydrated whole
  // like the org's *SettingsJson columns.
  phone                 String?
  // Text messages (2026-09-24): the mobile the office events are texted to,
  // verified by a six-digit code — the code is also the consent. Null: no texts.
  smsPhone              String?
  smsVerifiedAt         DateTime?
  notificationPrefsJson String?
  // Platform-admin authority for the (admin) console. Distinct from the
  // org-level Membership.role — only flagged users may reach platform-wide
  // money/influencer pages. Tightens the old "any OWNER/ADMIN of any org" gate.
  isPlatformAdmin       Boolean   @default(false)
  // Credential epoch for stateless-JWT session revocation. Stamped into the JWT
  // at sign-in and re-checked on every guarded request (requireUser); bumped on
  // password reset so all previously-issued tokens are invalidated at once —
  // the "log out everywhere" that a bare JWT strategy otherwise can't do.
  credentialVersion     Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  activeOrgId           String?

  accounts                 Account[]
  influencer               Influencer?
  supportTickets           SupportTicket[]
  supportMessages          SupportMessage[]
  sessions                 Session[]
  memberships              Membership[]
  workerProfile            WorkerProfile?
  assignedLeads            Lead[]                    @relation("LeadAssignee")
  claimedLeads             Lead[]                    @relation("LeadClaimer")
  proposals                Proposal[]                @relation("ProposalOwner")
  activities               ActivityEvent[]
  messages                 Message[]
  conversationParticipants ConversationParticipant[]
  sentInvites              Invite[]                  @relation("InviteSender")
  referralCodes            ReferralCode[]
  tradePosts               TradePost[]
  tradeReplies             TradeReply[]
  blockedTimes             BlockedTime[]
  unavailabilityRules      UnavailabilityRule[]
  appointmentsCreated      Appointment[]             @relation("AppointmentCreator")
  jobEventsCreated         JobEvent[]                @relation("JobEventCreator")
  phoneVerifications       PhoneVerification[]

  // Trade & Services (contractor-to-contractor job network)
  tradeNetworkProfile  TradeNetworkProfile?
  tradeJobsAuthored    TradeJob[]             @relation("TradeJobAuthor")
  tradeJobRecipients   TradeJobRecipient[]    @relation("TradeJobRecipientUser")
  tradeJobConvAuthored TradeJobConversation[] @relation("TradeJobConvAuthor")
  tradeJobConvReceived TradeJobConversation[] @relation("TradeJobConvRecipient")
  tradeJobMessages     TradeJobMessage[]      @relation("TradeJobMessageAuthor")

  // Admin task tracker (/admin/tasks, 2026-10-11) — back-relations only.
  adminTasksAssigned    AdminTask[]        @relation("AdminTaskAssignee")
  adminTasksAuthored    AdminTask[]        @relation("AdminTaskAuthor")
  adminSubtasksAssigned AdminTaskSubtask[] @relation("AdminSubtaskAssignee")
  adminTaskComments     AdminTaskComment[] @relation("AdminTaskCommentAuthor")
  adminTaskEvents       AdminTaskEvent[]   @relation("AdminTaskEventActor")

  // The cancel window's reasons and the trial-extension asks (2026-10-20) — back-relations only.
  cancellationFeedback   CancellationFeedback[]
  trialExtensionRequests TrialExtensionRequest[] @relation("TrialExtensionRequester")
  trialExtensionsDecided TrialExtensionRequest[] @relation("TrialExtensionDecider")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  type              String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  scope             String?
  token_type        String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("USER")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String    @default("USER")
  token          String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

// ─────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────

model Client {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  customFields   String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals      Proposal[]
  jobs           Job[]
  projects       Project[]
  activities     ActivityEvent[]
  tags           ClientTag[]
  payments       Payment[]
  reviewRequests ReviewRequest[]
  appointments   Appointment[]
  servicePlans   ServicePlan[]
  equipment      ClientEquipment[]
  visitReports   VisitReport[]
  bookings       Booking[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  label          String
  color          String @default("#4F46E5")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients      ClientTag[]

  @@unique([organizationId, label])
}

model ClientTag {
  clientId String
  tagId    String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  projectType    String?
  description    String?
  photos         String?   @default("[]")
  source         String?
  status         String    @default("NEW")
  aiCategory     String?
  // The professional scope carried over from the platform lead (2026-09-21).
  scope          String?
  aiConfidence   Float?
  assignedToId   String?
  claimedById    String?
  claimedAt      DateTime?
  contactedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?           @relation("LeadAssignee", fields: [assignedToId], references: [id])
  claimedBy    User?           @relation("LeadClaimer", fields: [claimedById], references: [id])
  activities   ActivityEvent[]
  phoneCalls   AiPhoneCall[]
  appointments Appointment[]
  bookings       Booking[]

  @@index([organizationId, status])
  @@index([assignedToId])
}

model HomeownerRequest {
  id              String        @id @default(cuid())
  organizationId  String?
  name            String
  email           String
  phone           String?
  address         String?
  zip             String?
  projectType     String?
  description     String?
  photos          String?       @default("[]")
  createdAt       DateTime      @default(now())
  convertedLeadId String?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Lead Center — platform-owned homeowner leads auto-routed to the best org.
// A PlatformLead is the routing state machine (HomeownerRequest stays the raw
// immutable submission log); the org-scoped Lead row is created only when an
// offer is accepted or an admin manually assigns. SQLite-safe string statuses
// live in src/lib/prismaEnums.ts (PlatformLeadStatus / LeadOfferStatus).
// ─────────────────────────────────────────────

model PlatformLead {
  id                 String    @id @default(cuid())
  homeownerRequestId String?   @unique
  name               String
  email              String
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  lat                Float?
  lng                Float?
  projectType        String?
  description        String?
  photos             String?   @default("[]")
  detectedTrade      String? // canonical TRADE_TYPES value (src/lib/tradeTypes.ts)
  // The request written for a contractor — what exists, what is to be done,
  // the sizes stated, what to confirm on site (lib/leadScope, 2026-09-21).
  // Null when the model was not reachable; the homeowner's words stand.
  scope              String?
  aiConfidence       Float?
  status             String    @default("MATCHING") // MATCHING | OFFERED | MATCHED | MANUAL_QUEUE
  attemptCount       Int       @default(0)
  // Capability token for the homeowner's status page (/request/[token]) — the
  // secret IS the authorization, like jf_admin's HMAC or CRON_SECRET. Nullable:
  // rows created before the page existed never got one and stay unreachable.
  accessToken        String?   @unique
  rankingJson        String? // snapshot: ordered [{orgId,orgName,score,distanceMi,distanceScore,ratingScore,respScore,fallback}]
  queueReason        String? // NO_CANDIDATES | EXHAUSTED
  matchedOrgId       String?
  matchedLeadId      String?
  matchedAt          DateTime?
  assignedByAdminId  String? // set when a platform admin manually assigns
  priceCents         Int? // schema-ready for pay-to-unlock; unused in v1
  // A test lead (2026-10-03): made through /homeowner?test=<key> or the admin's
  // "Create test lead". Never cascades, goes only to isInternal organizations,
  // and stays out of the Lead Center's statistics.
  isTest             Boolean   @default(false)
  // The homeowner's home dashboard this request belongs to (2026-10-03,
  // model Home): set by the intake, or adopted later by the email.
  homeId             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  offers LeadOffer[]
  home   Home?       @relation(fields: [homeId], references: [id])

  @@index([status, createdAt])
  @@index([homeId])
}

// ─────────────────────────────────────────────
// The homeowner's home dashboard (2026-10-03)
// ─────────────────────────────────────────────
// Made by the first request a homeowner submits, keyed by their email; the
// emailed link is the login. Every later request with that email joins it,
// so one page holds the house's projects, the plans for the next ones and
// what was said to the contractors. See lib/home/portal.

model Home {
  id          String    @id @default(cuid())
  // Lowercased: the one identity a request carries.
  email       String    @unique
  name        String
  phone       String?
  address     String?
  city        String?
  state       String?
  zip         String?
  // Capability token for /home/[key] — the emailed link IS the authorization.
  accessToken String    @unique
  // The browser's zone at the first submission; reminders land at 9 AM there.
  timezone    String?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads        PlatformLead[]
  plans        HomePlan[]
  messages     HomeMessage[]
  files        HomeFile[]
  fileRequests HomeFileRequest[]
}

// THE JOB FOLDER (2026-10-03): the pictures, videos and documents of one
// request, from the homeowner's dashboard (or asked for by the contractor),
// kept in the private file store (lib/media/privateStore) and read by the
// homeowner through the key and by the shop that has the lead. A file a
// contractor puts on a proposal is copied there; the folder keeps the original.
model HomeFile {
  id             String    @id @default(cuid())
  homeId         String
  platformLeadId String
  // The shop the request was with when the file arrived, told about it.
  organizationId String?
  // The stored URL (private blob, local: in development, data: before the
  // store exists) — read through /api/home-file/[id], never handed out.
  url            String
  name           String
  contentType    String
  bytes          Int
  media          String // photo | video | document
  note           String?
  uploadedBy     String    @default("HOMEOWNER") // HOMEOWNER | CONTRACTOR
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([platformLeadId, createdAt])
  @@index([homeId])
}

// "Could you send pictures of the attic?" — a shop's ask, answered by the next
// upload on that request.
model HomeFileRequest {
  id             String    @id @default(cuid())
  homeId         String
  platformLeadId String
  organizationId String
  note           String?
  requestedById  String?
  createdAt      DateTime  @default(now())
  fulfilledAt    DateTime?

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([platformLeadId, fulfilledAt])
}

// A project the homeowner means to do: on the dashboard's calendar, with a reminder when its month comes, and one tap away from becoming a request.
model HomePlan {
  id             String    @id @default(cuid())
  homeId         String
  title          String
  notes          String?
  // The month (its first day) or the day the homeowner has in mind.
  plannedFor     DateTime
  wholeMonth     Boolean   @default(true)
  remindAt       DateTime?
  remindedAt     DateTime?
  status         String    @default("PLANNED") // PLANNED | SUBMITTED | DONE | DROPPED
  // The request it became, once submitted from the dashboard.
  platformLeadId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, status])
  @@index([status, remindAt])
}

// What the homeowner wrote to a contractor from the dashboard — emailed to the shop with the homeowner as reply-to, and kept on the project.
model HomeMessage {
  id             String   @id @default(cuid())
  homeId         String
  platformLeadId String
  organizationId String
  body           String
  // False when no mail transport could carry it (the row still stands).
  emailed        Boolean  @default(false)
  createdAt      DateTime @default(now())

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([platformLeadId, createdAt])
}

model LeadOffer {
  id                 String    @id @default(cuid())
  platformLeadId     String
  organizationId     String
  attempt            Int // 1..3
  status             String    @default("OFFERED") // OFFERED | ACCEPTED | DECLINED | EXPIRED | CANCELLED | REJECTED_BY_CLIENT
  score              Float
  scoreBreakdownJson String? // {distanceMi,distanceScore,ratingScore,respScore,total,fallback}
  // Why the homeowner asked for another contractor (REJECTED_BY_CLIENT rows
  // only) — one of the portal's canned options or their own words. Optional by
  // design: the dialog skips in one tap.
  declineReason      String?
  expiresAt          DateTime
  respondedAt        DateTime?
  respondedById      String?
  priceCents         Int? // schema-ready for pay-to-unlock; unused in v1
  unlockedAt         DateTime? // schema-ready masking gate; unused in v1
  createdAt          DateTime  @default(now())

  platformLead PlatformLead @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([platformLeadId, organizationId]) // an org is never offered the same lead twice
  @@index([organizationId, status])
  @@index([status, expiresAt]) // cron expiry sweep
}

// ─────────────────────────────────────────────
// Proposals + Money
// ─────────────────────────────────────────────

model Proposal {
  id             String  @id @default(cuid())
  publicId       String  @unique
  // Which estimator made it — "fence", "roof", "hvac" — so the trade boards
  // (2026-09-20) list it and its materials count against that trade's stock.
  trade          String?
  organizationId String
  ownerId        String?
  clientId       String?
  // The project the proposal belongs to (2026-09-18). Its change orders and
  // the job it becomes follow it there. Null = not in a project.
  projectId      String?
  title          String
  description    String?
  scopeOfWork    String?
  notes          String?
  // Job address — optional one-liner, seeded from the client / AI-estimator
  // location; its state drives the tax-rate estimate in the builder.
  address        String?
  status         String  @default("DRAFT")
  subtotal       Float   @default(0)
  discountTotal  Float   @default(0)
  taxRate        Float   @default(0)
  taxTotal       Float   @default(0)
  total          Float   @default(0)
  currency       String  @default("USD")

  // Estimating engine — markup ladder applied to base material/labor costs
  materialMarkupPct Float     @default(0)
  laborMarkupPct    Float     @default(0)
  overheadPct       Float     @default(0)
  profitPct         Float     @default(0)
  // "Show to client" (owner, 2026-09-17): how each line's price reads on the
  // client's copy — one total, or its labor and material halves — and whether
  // the scope and the signature lines print. Presentation only; never the price.
  showBreakdown     Boolean   @default(true)
  showScope         Boolean   @default(true)
  showSignature     Boolean   @default(true)
  // Where overhead and profit land inside the breakdown: across both halves
  // (false) or in the labor half, materials reading at cost (true). They are
  // always inside the line prices, never a row of their own.
  marginOnLabor     Boolean   @default(false)
  validUntil        DateTime?
  sentAt            DateTime?
  viewedAt          DateTime?
  viewCount         Int       @default(0)
  acceptedAt        DateTime?
  acceptedIp        String?
  declinedAt        DateTime?
  paidAt            DateTime?
  pdfUrl            String?
  aiDraftId         String?
  beforePhotos      String?   @default("[]")
  afterPhotos       String?   @default("[]")
  // Bumped whenever an UNPAID installment's amount/label/membership changes.
  // Checkout sessions carry the version they were minted under, so a payment
  // landing on a stale version is reconciled instead of trusted blindly.
  scheduleVersion   Int       @default(1)
  // Automatic payment reminders for THIS proposal: true / false override the
  // company's reminder mode; null follows it (settings → payments).
  remindersOn       Boolean?
  // "Listen to this proposal" (2026-09-23): the spoken summary's cached audio
  // file and the hash of the script it was read from (lib/proposalAudio). A
  // price change moves the hash and the next play regenerates the audio.
  audioUrl          String?
  audioScriptHash   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?             @relation("ProposalOwner", fields: [ownerId], references: [id])
  audio        ProposalAudio?
  client       Client?           @relation(fields: [clientId], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lineItems    LineItem[]
  discounts    Discount[]
  installments Installment[]
  invoices     Invoice[]
  payments     Payment[]
  activities   ActivityEvent[]
  jobs         Job[]
  changeOrders ChangeOrder[]
  aiDraft      AiDraft?          @relation(fields: [aiDraftId], references: [id])
  snapshots    PricingSnapshot[]
  appointments Appointment[]
  reviewRequests ReviewRequest[]

  @@index([organizationId, status])
  @@index([publicId])
  @@index([projectId])
}

model PricingSnapshot {
  id             String   @id @default(cuid())
  proposalId     String
  organizationId String
  reason         String   @default("manual") // manual | sent | accepted | edited
  subtotal       Float
  discountTotal  Float    @default(0)
  taxRate        Float    @default(0)
  taxTotal       Float
  total          Float
  currency       String   @default("USD")
  lineItemsJson  String // JSON-encoded snapshot of line items
  createdAt      DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

// "Listen to this proposal" (2026-09-24): the spoken summary's MP3, kept in
// the database — production has no Blob store, and a forty-second file is a
// few hundred kilobytes. One per proposal; a new script replaces it. Served
// by /api/public-quote/[publicId]/audio/file, cached for a year by hash.
model ProposalAudio {
  proposalId String   @id
  hash       String
  model      String
  voice      String
  bytes      Bytes
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model LineItem {
  id              String  @id @default(cuid())
  proposalId      String
  name            String
  description     String?
  measurementType String  @default("UNIT")
  quantity        Float   @default(1)
  unitPrice       Float   @default(0)
  materialCost    Float   @default(0)
  laborCost       Float   @default(0)
  total           Float   @default(0)
  position        Int     @default(0)

  // Live-pricing product metadata from the AI estimator's SerpAPI matches, so
  // the Materials Request view can render a shoppable line. Null for hand-typed
  // or labor lines.
  store      String?
  productUrl String?
  imageUrl   String?
  dimensions String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Discount {
  id         String  @id @default(cuid())
  proposalId String
  label      String
  amount     Float   @default(0)
  isPercent  Boolean @default(false)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Installment {
  id         String    @id @default(cuid())
  proposalId String
  label      String
  amount     Float
  isPercent  Boolean   @default(false)
  dueDate    DateTime?
  position   Int       @default(0)
  // Payment-stage state (src/lib/paymentSchedule.ts is the only place that
  // derives money from these). UNPAID | PENDING (a checkout is open) | PAID |
  // WAIVED (proposal reached PAID before this stage was collected).
  status           String    @default("UNPAID")
  paidAt           DateTime?
  // Frozen dollars actually settled for this stage. A PAID stage never
  // recomputes from `amount`/`isPercent` again, even if the total changes.
  paidAmount       Float?
  paymentId        String?
  // Open checkout, while PENDING: provider + its session/link id (+ Square's
  // order id, which is what payment.updated carries back).
  checkoutProvider String?
  checkoutRef      String?
  checkoutOrderId  String?
  checkoutOpenedAt DateTime?
  // Set when an approved change order created this stage. Such a stage is
  // locked: the proposal builder neither drops nor re-prices it.
  changeOrderId    String?   @unique
  // Payment reminders (2026-09-13): when the client was last nudged for this
  // stage and how many rungs of the ladder have gone out (auto or manual).
  remindedAt       DateTime?
  reminderCount    Int       @default(0)
  // The last invoice sent for this stage and the rail the office chose for it
  // (card | bank | any) — the portal link carries the choice.
  invoiceMethod    String?
  invoiceSentAt    DateTime?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([proposalId, position])
  @@index([checkoutRef])
  @@index([checkoutOrderId])
}

model ProposalTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  proposalId     String?
  clientId       String?
  number         String
  /// What this row is worth in every money total: the ask while it is open,
  /// and what actually landed on its installments once it is settled.
  amount         Float
  /// What the client was ASKED for, stamped when the invoice was sent and left
  /// alone afterwards. Settlement re-states `amount`, so without this the
  /// figure in the client's email would be lost; the book shows both when they
  /// differ. Null on rows nobody was sent (a receipt settlement wrote itself,
  /// and every row that predates this column).
  billedAmount   Float?
  status         String    @default("PENDING")
  provider       String    @default("MANUAL")
  externalId     String?
  dueDate        DateTime?
  paidAt         DateTime?
  // The service plan this invoice bills (2026-09-22); null for a proposal invoice.
  servicePlanId  String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id])
  payments     Payment[]
  servicePlan  ServicePlan? @relation(fields: [servicePlanId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model Payment {
  id             String    @id @default(cuid())
  organizationId String
  proposalId     String?
  invoiceId      String?
  clientId       String?
  amount         Float
  currency       String    @default("USD")
  provider       String    @default("STRIPE") // STRIPE | SQUARE | MANUAL
  status         String    @default("PENDING") // PENDING | PAID | PARTIAL | REFUNDED | PARTIALLY_REFUNDED | VOID
  externalId     String? // Stripe checkout session id / Square order id — dedupe key
  method         String? // card | us_bank_account | BANK_TRANSFER | CASH | CHECK | OTHER
  paidAt         DateTime?
  // Platform payments (contractor's own Stripe/Square via JobFlex). Money in
  // dollars like `amount`; the settle path is the only writer.
  feeAmount         Float    @default(0) // JobFlex application fee
  netAmount         Float? // amount − feeAmount
  externalPaymentId String? // Stripe payment_intent / Square payment id — refunds key on this
  livemode          Boolean  @default(true)
  refundedAmount    Float    @default(0)
  scheduleVersion   Int? // Proposal.scheduleVersion the checkout was minted under
  meta              String? // JSON: {orphan, unappliedMinor, duplicate, note}
  // Key-joined Stripe: the fee can't ride inside the charge, so it is billed
  // as an invoice item on the org's JobFlex subscription — the `ii_…` id once
  // that happened. Null on a key-joined payment = accrued in the ledger only
  // (no subscription customer to bill), for the operator to collect by hand.
  feeInvoiceItemId  String?
  createdAt      DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?     @relation(fields: [proposalId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  installments Installment[]

  @@unique([provider, externalId])
  @@index([organizationId, status])
  @@index([provider, externalPaymentId])
}

// One row per org × provider for "get paid through JobFlex". Stripe = either a
// Connect Standard account joined by OAuth (we store only the acct id — every
// API call uses the platform key + Stripe-Account header) or, since
// 2026-09-12, the contractor's OWN API key pasted in Settings (stripeKeyEnc,
// encrypted at rest — every call uses that key, no header, no application
// fee). Square = OAuth tokens, encrypted at rest (src/lib/crypto/secretBox.ts).
// Disconnect = delete row.
model PaymentConnection {
  id             String @id @default(cuid())
  organizationId String
  provider       String // STRIPE | SQUARE
  status         String @default("ACTIVE") // ACTIVE | RESTRICTED | REVOKED

  stripeAccountId        String?
  stripeLivemode         Boolean?
  stripeChargesEnabled   Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)
  stripeAchEnabled       Boolean @default(false)
  // "Paste an API key" join: the contractor's secret (sk_) or restricted (rk_)
  // key, AES-GCM at rest. Present = this row charges with the key itself;
  // JobFlex's cut is billed separately (Payment.feeInvoiceItemId).
  stripeKeyEnc           String?
  stripeKeyKind          String? // sk | rk
  stripeKeyLast4         String?
  // Webhook endpoint registered ON THE CONTRACTOR'S account with that key,
  // pointed at /api/webhooks/stripe-key/<this row's id>, and its signing
  // secret (Stripe returns it once, at creation). Null = registration failed;
  // the portal's active verification + the reconcile cron still settle.
  stripeWebhookId        String?
  stripeWebhookSecretEnc String?

  squareMerchantId      String?
  squareLocationId      String?
  squareLocationName    String?
  squareAccessTokenEnc  String?
  squareRefreshTokenEnc String?
  squareTokenExpiresAt  DateTime?
  squareEnv             String? // sandbox | production at connect time
  // "Paste an access token" join (2026-09-13): the seller's own personal
  // access token from their Square developer app — no refresh token, no
  // expiry, and no app fee (that needs the platform app), so JobFlex's cut is
  // billed on the JobFlex invoice. squareAuth = oauth | token.
  squareAuth                   String?
  squareTokenLast4             String?
  // Webhook subscription registered on THEIR app with that token, pointed at
  // /api/webhooks/square-key/<this row's id>, and its signature key.
  squareWebhookId              String?
  squareWebhookSignatureKeyEnc String?

  // Stax (2026-09-13): the merchant API key pasted in Settings, encrypted at
  // rest. Stax webhook payloads are unsigned, so the target URL carries a
  // random secret and every event is re-read from Stax before it settles
  // anything. staxWebhookIds = JSON array of the webhook ids we registered.
  staxApiKeyEnc        String?
  staxKeyLast4         String?
  staxMerchantId       String?
  staxMerchantName     String?
  staxWebhookIds       String?
  staxWebhookSecretEnc String?

  currency          String? // provider default currency; checked against Proposal.currency
  country           String? // Square app-fee same-country rule
  lastError         String?
  connectedByUserId String?
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  // One Stripe account, one workspace (audit, 2026-09-20): the webhook
  // handlers resolve the org from acct_… and a second row on the same
  // account would make that lookup arbitrary. Nulls are distinct, so rows
  // without an account id (Square, Stax) are unaffected.
  @@unique([stripeAccountId, provider])
  @@index([squareMerchantId])
}

// ─────────────────────────────────────────────
// Scheduling + Jobs + Workers
// ─────────────────────────────────────────────

model Job {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String?
  proposalId     String?
  projectId      String?
  title          String
  status         String    @default("SCHEDULED")
  scopeOfWork    String? // seeded from the linked proposal's scope; shown above notes on the job
  // When the crew marked the pick list loaded from the warehouse (2026-09-20).
  materialsLoadedAt DateTime?
  notes          String?
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id])
  proposal       Proposal?       @relation(fields: [proposalId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events         JobEvent[]
  assignments    JobAssignment[]
  photos         JobPhoto[]
  expenses       JobExpense[]
  workDays       WorkDay[]
  messages       JobMessage[]
  conversation   Conversation?
  changeOrders   ChangeOrder[]
  reviewRequests ReviewRequest[]

  @@index([organizationId, status])
  @@index([projectId])
}

model JobEvent {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String?
  // Who created it — lets a jobless event (installer's optional-job path) still
  // render on its creator's own calendar. Nullable: legacy events have none.
  createdById    String?
  title          String
  startsAt       DateTime
  endsAt         DateTime
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id])
  createdBy    User?        @relation("JobEventCreator", fields: [createdById], references: [id])

  @@index([organizationId, startsAt])
}

model WorkerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  organizationId String
  displayName    String
  phone          String?
  // Text messages (2026-09-24): the office ticks "text their schedule" and the
  // worker gets a welcome text with the STOP line; a STOP reply wins over it.
  smsOptIn       Boolean   @default(false)
  smsOptedInAt   DateTime?
  specialties    String?   @default("[]")
  hourlyRate     Float?
  token          String    @unique @default(cuid())
  // Invite lifecycle: PENDING (sent, awaiting response) → ACCEPTED / DECLINED.
  // Defaults to ACCEPTED so legacy profiles (created before this feature) stay
  // active; createWorkerInvite sets PENDING explicitly for new/re-invites.
  // DECLINED is excluded from the "workers" plan-limit count (frees the seat).
  inviteStatus   String    @default("ACCEPTED")
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  // Rolling "last time this worker was genuinely active in their portal" (see
  // touchWorkerActivity). Nullable: existing rows stay null until the one-time
  // backfill runs. The inactivity cron NEVER revokes a null row — only a real
  // date older than 6 months — so null is always safe.
  lastSeenAt     DateTime?

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments            JobAssignment[]
  appointmentAssignments AppointmentAssignment[]

  @@index([organizationId])
  @@index([lastSeenAt])
}

model JobAssignment {
  id         String    @id @default(cuid())
  jobId      String
  workerId   String
  status     String    @default("PENDING")
  assignedAt DateTime  @default(now())
  pingedAt   DateTime?
  // What this worker is paid for this job — the office sets it when the job
  // is handed over (2026-09-20). It is the crew cost of the job, never the
  // client's price, and it is what the worker sees on their own card.
  pay        Float     @default(0)
  // Marked by the office when the pay has actually been handed over.
  paidAt     DateTime?

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId])
  // Worker-side lists and badge counts read by workerId, newest first.
  @@index([workerId, assignedAt])
}

// A DAY ON SITE (2026-09-30, stage A of crew days / media / worker expenses).
// One row per job and local date (the organization's timezone), opened by a
// Start or a Back-on-site press — or by the office moving the status — and
// closed by the crew with a note or at least one photo / video of the day.
// A day left open past its date reads PENDING ("passed, needs closing") and
// can be closed later. Several crew on one job share the one day.
// Status: OPEN | CLOSED | PENDING (src/lib/prismaEnums.ts WorkDayStatus).
model WorkDay {
  id             String    @id @default(cuid())
  jobId          String
  organizationId String
  // "2026-09-30" in the organization's timezone.
  date           String
  dayNumber      Int
  status         String    @default("OPEN")
  openedById     String?
  closedById     String?
  closedAt       DateTime?
  note           String?
  // worker | office — who opened it.
  source         String    @default("worker")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  photos       JobPhoto[]

  @@unique([jobId, date])
  @@index([organizationId, status])
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  url       String
  kind      String   @default("BEFORE")
  caption   String?
  analysis  String? // JSON-encoded vision output
  createdAt DateTime @default(now())
  // Stage A (2026-09-30): the columns behind the crew's gallery. Older rows
  // leave them null and are read as before (the analysis JSON marks a video).
  uploadedById String?
  workDayId    String?
  // photo | video
  media        String?
  contentType  String?
  bytes        Int?
  // Set when the crew edits the caption after upload ("edited" mark).
  editedAt     DateTime?

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workDay WorkDay? @relation(fields: [workDayId], references: [id], onDelete: SetNull)

  @@index([workDayId])
}

model JobExpense {
  id         String   @id @default(cuid())
  // Null for a purchase FOR STOCK (stage D, 2026-09-30): the money is the
  // company's the day it is spent and the warehouse's value; it reaches a job
  // only when the stock is issued to it (InventoryMovement PICKED / USED at
  // its unitCost). A receipt for a job is purpose JOB with its jobId.
  jobId      String?
  category   String
  amount     Float
  note       String?
  receiptUrl String?
  ocrJson    String? // JSON-encoded OCR output
  createdAt  DateTime @default(now())
  // Stage A (2026-09-30): a worker's receipt is SUBMITTED and counts nowhere
  // until the owner or a manager APPROVES it (or REJECTS it with a reason);
  // REIMBURSED marks the money handed back to a worker who paid from their
  // own pocket (paidBy WORKER). Rows from before the change read APPROVED
  // and COMPANY, so no total moved. (src/lib/prismaEnums.ts ExpenseStatus.)
  organizationId String?
  submittedById  String?
  paidBy         String    @default("COMPANY")
  status         String    @default("APPROVED")
  rejectReason   String?
  reviewedById   String?
  reviewedAt     DateTime?
  reimbursedAt   DateTime?
  vendor         String?
  // When the money was spent; the totals go by it (createdAt when null).
  spentAt        DateTime?
  // Set when the row is edited after it was submitted ("edited" mark).
  editedAt       DateTime?
  // "JOB" | "STOCK" — what the money bought (stage D). STOCK rows have no job;
  // the item and quantity, when given, set the item's lastCost on approval.
  purpose        String    @default("JOB")
  stockItemId    String?
  stockQty       Float?

  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model JobMessage {
  id        String   @id @default(cuid())
  jobId     String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Comms
// ─────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String?  @unique
  // DIRECT (1:1) | GROUP (manager-created, multi-person) | JOB (auto-created from a job's crew)
  kind           String   @default("DIRECT")
  title          String?
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]

  @@index([organizationId, createdAt])
  @@index([organizationId, kind])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime  @default(now())
  lastReadAt     DateTime?
  // Per-person "clear thread" watermark: this participant sees only messages
  // newer than this. Clearing NEVER deletes Message rows — the other side
  // keeps their copy (owner request 2026-08-21).
  clearedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// Per-user "last looked at this nav surface" timestamps. Drives view-based
// clearing of the sidebar/tab-bar badges: a badge counts only items newer than
// the user's seenAt for that surface, so visiting the page clears it until
// something new arrives. `key` is a short surface id ("leads" | "proposals" |
// "hire" | "referrals" | "reviews"). Scalar userId/organizationId (no
// relations) keeps the blast radius to this one model; orphaned rows after a
// delete are harmless. The unique index doubles as the lookup index.
model NavSeen {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  key            String
  seenAt         DateTime @default(now())

  @@unique([userId, organizationId, key])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])

  // Hot paths: the 5-second inbox poll (conversationId + createdAt > since),
  // unread groupBy, and the messagesSent plan meter (createdAt range).
  @@index([conversationId, createdAt])
  @@index([authorId])
  @@index([createdAt])
}

model Announcement {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  body           String
  priority       Int       @default(0)
  scope          String    @default("ORG") // ORG | PLATFORM
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([scope, createdAt])
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String
  category       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Automation
// ─────────────────────────────────────────────

model FollowUpRule {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  triggerStatus  String
  delayMinutes   Int
  enabled        Boolean @default(true)
  template       String?
  /// One of the starter rules every company gets (lib/followUps/defaults).
  /// Deleting one turns it off instead, so ensureDefaultFollowUpRules never
  /// brings it back.
  isDefault      Boolean @default(false)
  /// Which starter rule this row is (DEFAULT_RULES key); null on the owner's own rules.
  defaultKey     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

